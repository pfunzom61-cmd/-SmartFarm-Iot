<Window x:Class="GreenGrowIoTMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GreenGrowIoTMonitor"
        mc:Ignorable="d"
        Title="GreenGrow IoT Monitor" Height="620" Width="880"
        WindowStartupLocation="CenterScreen" Background="#0F172A">

    <Window.Resources>
        <!-- Modern Glass Card Style -->
        <Style x:Key="GlassCard" TargetType="Border">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="15" Color="#000000" Opacity="0.3" ShadowDepth="4"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Button Styling with Hover Effect -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" TargetName="border" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" TargetName="border" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Header Bar -->
        <Border Grid.Row="0" Style="{StaticResource GlassCard}" Padding="20,16" Margin="0,0,0,20" Background="#166534" BorderBrush="#22C55E">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="8" Background="#22C55E" Margin="0,0,12,0">
                        <TextBlock Text="🌿" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="GreenGrow IoT Monitor" Foreground="White" FontSize="20" FontWeight="Black"/>
                        <TextBlock Text="Smart Greenhouse Array • Pretoria Node" Foreground="#BBF7D0" FontSize="11" FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>

                <!-- Location Chip -->
                <Border HorizontalAlignment="Right" Background="#15803D" CornerRadius="20" Padding="12,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📍 " FontSize="12"/>
                        <TextBlock Text="Pretoria, South Africa" Foreground="#F0FDF4" FontSize="12" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Live Sensor Cards -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,20">
            <!-- Temperature Card -->
            <Border Style="{StaticResource GlassCard}" Padding="16" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="🌡️ TEMPERATURE" Foreground="#94A3B8" FontSize="10" FontWeight="Bold"/>
                    <TextBlock x:Name="TxtTemperature" Text="-- °C" Foreground="#4ADE80" FontSize="24" FontWeight="Black" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- Humidity Card -->
            <Border Style="{StaticResource GlassCard}" Padding="16" Margin="4,0,4,0">
                <StackPanel>
                    <TextBlock Text="💧 HUMIDITY" Foreground="#94A3B8" FontSize="10" FontWeight="Bold"/>
                    <TextBlock x:Name="TxtHumidity" Text="-- %" Foreground="#38BDF8" FontSize="24" FontWeight="Black" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- Wind Speed Card -->
            <Border Style="{StaticResource GlassCard}" Padding="16" Margin="4,0,4,0">
                <StackPanel>
                    <TextBlock Text="💨 WIND SPEED" Foreground="#94A3B8" FontSize="10" FontWeight="Bold"/>
                    <TextBlock x:Name="TxtWind" Text="-- km/h" Foreground="#FACC15" FontSize="24" FontWeight="Black" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- Soil Temp Card -->
            <Border Style="{StaticResource GlassCard}" Padding="16" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="🌱 SOIL TEMP" Foreground="#94A3B8" FontSize="10" FontWeight="Bold"/>
                    <TextBlock x:Name="TxtSoil" Text="-- °C" Foreground="#FB923C" FontSize="24" FontWeight="Black" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Main Workspace (Stack History + Action Controls) -->
        <Grid Grid.Row="2" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- LIFO Stack Visualizer Display -->
            <Border Grid.Column="0" Style="{StaticResource GlassCard}" Padding="20" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="🧠 LIFO Memory Stack" FontSize="16" FontWeight="Bold" Foreground="White"/>
                        <Border Background="#334155" CornerRadius="10" Padding="8,2" Margin="10,0,0,0">
                            <TextBlock Text="Temperature History" Foreground="#94A3B8" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>

                    <Separator Grid.Row="1" Background="#334155" Margin="0,0,0,16"/>

                    <!-- History Text Cards -->
                    <StackPanel Grid.Row="2" VerticalAlignment="Center">
                        <Border Background="#0F172A" CornerRadius="8" Padding="14" Margin="0,0,0,12" BorderBrush="#334155" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📦 " FontSize="16"/>
                                <TextBlock x:Name="TxtHistoryCount" Text="Stored Readings: 0" FontSize="14" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#0F172A" CornerRadius="8" Padding="14" BorderBrush="#334155" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="TOP OF STACK (PEEK TARGET)" Foreground="#38BDF8" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                                <TextBlock x:Name="TxtLatestReading" Text="Latest Stored Reading: No readings stored" FontSize="13" Foreground="#CBD5E1" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Interactive Operations Panel -->
            <Border Grid.Column="1" Style="{StaticResource GlassCard}" Padding="20" Margin="10,0,0,0">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="OPERATIONS" Foreground="#94A3B8" FontSize="10" FontWeight="Bold" Margin="0,0,0,14" HorizontalAlignment="Center"/>

                    <!-- Fetch API Button -->
                    <Button x:Name="BtnFetch" Content="⚡ FETCH API DATA" Style="{StaticResource ActionButton}" Background="#16A34A" Click="BtnFetch_Click"/>

                    <!-- View Latest (Peek) Button -->
                    <Button x:Name="BtnPeek" Content="🔍 VIEW LATEST (PEEK)" Style="{StaticResource ActionButton}" Background="#2563EB" Click="BtnPeek_Click"/>

                    <!-- Remove Latest (Pop) Button -->
                    <Button x:Name="BtnPop" Content="🗑️ REMOVE LATEST (POP)" Style="{StaticResource ActionButton}" Background="#DC2626" Click="BtnPop_Click"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- System Status Bar -->
        <Border Grid.Row="3" Background="#0F172A" CornerRadius="8" Padding="12,8" BorderBrush="#334155" BorderThickness="1">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="SYSTEM STATUS: " Foreground="#64748B" FontSize="11" FontWeight="Bold"/>
                    <TextBlock x:Name="TxtSystemStatus" Text="OFFLINE" Foreground="#EF4444" FontSize="11" FontWeight="Black"/>
                </StackPanel>
                <TextBlock Text="Open-Meteo REST API • Stack Engine Active" Foreground="#475569" FontSize="11" HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</Window>